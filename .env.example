# Local hybrid retrieval
RAG_SEMANTIC_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_DIMENSIONS=384
RAG_RRF_K=60
RAG_TOP_K=5
RAG_MINIMUM_SIMILARITY=-0.05

# Sarvam Speech-to-Text
# Obtain a key from Sarvam and keep the real value only in your git-ignored .env file.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3

# Grounded answer generation
# This uses an OpenAI-compatible Chat Completions endpoint with a strict JSON response contract.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Hugging Face access for official MSMARCO-XI parquet downloads
HF_TOKEN=
